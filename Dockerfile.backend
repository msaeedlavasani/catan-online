FROM node:22-alpine

WORKDIR /app/server

COPY server/package*.json ./
RUN npm ci --omit=dev

COPY server/ ./
COPY shared/ /app/shared/

ENV NODE_ENV=production
ENV PORT=4000
ENV CLIENT_ORIGIN=https://catan.saeedlavasani.ir
ENV STORAGE_PATH=/app/server/data/rooms
ENV STORAGE_REQUIRED=true

RUN mkdir -p /app/server/data/rooms

EXPOSE 4000

CMD ["npm", "start"]
