# Public origin of the frontend. Required when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173

# Port exposed by the Socket.io server.
PORT=4000

# In-game room retention after all players disconnect (milliseconds).
ROOM_TTL_MS=300000

# JSON persistence directory. Relative paths are resolved from server CWD.
STORAGE_PATH=data/rooms
STORAGE_REQUIRED=false

# Mark readiness unhealthy above this heap usage ratio.
READINESS_MEMORY_THRESHOLD=0.9
